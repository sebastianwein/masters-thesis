\newlabel{fig:detr:detr_deltat}{{9.9}{77}{Detection ratio as a function of signal separation for the transformer-encoder heatmap regressor (\emph {blue}) and for DETR (\emph {orange}). Computed over \SI {66}{\kilo \nothing } samples with \SI {131}{\kilo \nothing } signals. Uncertainties are too small to be visualized}{figure.caption.54}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.10}{\ignorespaces Performance with signal separation for DETR (\emph  {left}) and for the heatmap regressor (\emph  {right}).}}{77}{figure.caption.55}\protected@file@percent }
\newlabel{fig:detr:deltat_cases}{{9.10}{77}{Performance with signal separation for DETR (\emph {left}) and for the heatmap regressor (\emph {right})}{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.11}{\ignorespaces Three example DETR outputs for $\Delta t_\text  {coa}=\SI {1}{\second }$ (\emph  {left}), $\Delta t_\text  {coa}=\SI {0.3}{\second }$ (\emph  {middle}) and $\Delta t_\text  {coa}=\SI {0.1}{\second }$ (\emph  {right}).}}{77}{figure.caption.56}\protected@file@percent }
